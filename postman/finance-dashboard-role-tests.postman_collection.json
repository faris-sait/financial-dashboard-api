          },
          "response": []
        },
        {
          "name": "Resolve Analyst Id (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "var email = pm.environment.get('analyst_email').toLowerCase();",
                  "var found = (j.data || []).find(function (u) { return (u.email || '').toLowerCase() === email; });",
                  "pm.test('analyst found', function () { pm.expect(found).to.exist; });",
                  "if (found) { pm.environment.set('analyst_user_id', String(found.id)); }"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/users"
          },
          "response": []
        },
